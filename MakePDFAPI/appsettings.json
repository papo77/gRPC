{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "MakePDF-API",
    "ServiceVersion": "1.0.0",
    "ServiceInstanceId": "instance-1",
    "Tracing": {
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "AspNetCore": {
        "RecordException": true,
        "EnableGrpcAspNetCoreSupport": true
      },
      "Http": {
        "SetHttpFlavor": true,
        "RecordException": true
      }
    },
    "Metrics": {
      "EnableRuntimeInstrumentation": true,
      "EnableProcessInstrumentation": true,
      "AspNetCore": {
        "EnableGrpcAspNetCoreSupport": true
      },
      "ConsoleExporter": {
        "Enabled": true
      }
    },
    "Logs": {
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true,
      "ConsoleExporter": {
        "Enabled": true
      }
    }
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Http": {
        "Url": "http://+:5002",
        "Protocols": "Http2"
      },
      "Https": {
        "Url": "https://+:5555",
        "Certificate": {
          "Path": "/Volumes/IronHide/dev/NET/grpc/MakePDF/MakePDFAPI/cert/primus.local.p12",
          "Password": "Kutas1234!"
        }
      }
    }
  }
}